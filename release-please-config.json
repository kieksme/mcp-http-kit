{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-v-in-tag": false,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "chore${scope}: release ${version}",
  "packages": {
    ".": {
      "component": "mcp-http-kit",
      "package-name": "@kieksme/mcp-http-kit",
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Changed" },
        { "type": "revert", "section": "Changed" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "security", "section": "Security" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Changed", "hidden": true },
        { "type": "refactor", "section": "Changed", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true }
      ]
    }
  }
}
